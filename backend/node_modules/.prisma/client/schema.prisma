generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  clerkId    String   @unique @map("clerk_id")
  name       String   @default("")
  email      String
  phone      String?
  role       String   @default("member")
  avatarUrl  String?  @map("avatar_url")
  bio        String?
  department String?
  joinedAt   DateTime @default(now()) @map("joined_at")

  sermons            Sermon[]
  sermonNotes        SermonNote[]
  posts              Post[]
  postLikes          PostLike[]
  comments           Comment[]
  createdGroups      Group[]             @relation("GroupCreator")
  groupMembers       GroupMember[]
  messagesSent       Message[]           @relation("MessagesSent")
  messagesReceived   Message[]           @relation("MessagesReceived")
  liveStreams        LiveStream[]
  streamMessages     StreamMessage[]
  events             Event[]
  rsvps              Rsvp[]
  formsSubmitted     Form[]              @relation("FormSubmitter")
  formsAssigned      Form[]              @relation("FormAssignee")
  givingTransactions GivingTransaction[]
  courses            Course[]
  enrollments        Enrollment[]
  quizAttempts       QuizAttempt[]
  podcastEpisodes    PodcastEpisode[]
  orders             Order[]
  notifications      Notification[]
  attendance         Attendance[]

  @@map("users")
}

model Sermon {
  id              String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  title           String
  description     String?
  speaker         String    @default("Pastor")
  series          String?
  mediaUrl        String    @map("media_url")
  thumbnailUrl    String?   @map("thumbnail_url")
  type            String // audio, video
  durationSeconds Int?      @map("duration_seconds")
  publishedAt     DateTime? @default(now()) @map("published_at")
  createdBy       String?   @map("created_by") @db.Uuid

  user  User?        @relation(fields: [createdBy], references: [id])
  notes SermonNote[]

  @@map("sermons")
}

model SermonNote {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  sermonId  String   @map("sermon_id") @db.Uuid
  content   String   @default("")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  sermon Sermon @relation(fields: [sermonId], references: [id], onDelete: Cascade)

  @@unique([userId, sermonId])
  @@map("sermon_notes")
}

model Post {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  body       String
  mediaUrl   String?  @map("media_url")
  mediaType  String?  @map("media_type") // image, video
  likesCount Int      @default(0) @map("likes_count")
  createdAt  DateTime @default(now()) @map("created_at")

  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes    PostLike[]
  comments Comment[]

  @@map("posts")
}

model PostLike {
  postId String @map("post_id") @db.Uuid
  userId String @map("user_id") @db.Uuid

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@map("post_likes")
}

model Comment {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("comments")
}

model Group {
  id          String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name        String
  description String?
  isPrivate   Boolean @default(false) @map("is_private")
  coverUrl    String? @map("cover_url")
  createdBy   String? @map("created_by") @db.Uuid

  creator  User?         @relation("GroupCreator", fields: [createdBy], references: [id])
  members  GroupMember[]
  messages Message[]

  @@map("groups")
}

model GroupMember {
  groupId  String   @map("group_id") @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  role     String   @default("member")
  joinedAt DateTime @default(now()) @map("joined_at")

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@map("group_members")
}

model Message {
  id         String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  senderId   String    @map("sender_id") @db.Uuid
  receiverId String?   @map("receiver_id") @db.Uuid
  groupId    String?   @map("group_id") @db.Uuid
  body       String
  readAt     DateTime? @map("read_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  sender   User   @relation("MessagesSent", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User?  @relation("MessagesReceived", fields: [receiverId], references: [id])
  group    Group? @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@map("messages")
}

model LiveStream {
  id            String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  muxStreamId   String?   @map("mux_stream_id")
  muxPlaybackId String?   @map("mux_playback_id")
  title         String
  description   String?
  status        String    @default("idle")
  scheduledAt   DateTime? @map("scheduled_at")
  endedAt       DateTime? @map("ended_at")
  createdBy     String?   @map("created_by") @db.Uuid

  user     User?           @relation(fields: [createdBy], references: [id])
  messages StreamMessage[]

  @@map("live_streams")
}

model StreamMessage {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  streamId  String   @map("stream_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  stream LiveStream @relation(fields: [streamId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("stream_messages")
}

model Event {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  title       String
  description String?
  date        DateTime
  endDate     DateTime? @map("end_date")
  location    String?
  coverUrl    String?   @map("cover_url")
  isPaid      Boolean   @default(false) @map("is_paid")
  ticketPrice Decimal?  @map("ticket_price") @db.Decimal(12, 2)
  createdBy   String?   @map("created_by") @db.Uuid

  user       User?        @relation(fields: [createdBy], references: [id])
  rsvps      Rsvp[]
  attendance Attendance[]

  @@map("events")
}

model Rsvp {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  eventId   String   @map("event_id") @db.Uuid
  qrCode    String   @unique @map("qr_code")
  checkedIn Boolean  @default(false) @map("checked_in")
  createdAt DateTime @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@map("rsvps")
}

model Form {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  type        String // salvation, visitor, prayer, testimony
  dataJson    Json     @default("{}") @map("data_json")
  submittedBy String?  @map("submitted_by") @db.Uuid
  assignedTo  String?  @map("assigned_to") @db.Uuid
  status      String   @default("new")
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")

  submitter User? @relation("FormSubmitter", fields: [submittedBy], references: [id])
  assignee  User? @relation("FormAssignee", fields: [assignedTo], references: [id])

  @@map("forms")
}

model GivingTransaction {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  amount     Decimal  @db.Decimal(12, 2)
  currency   String   @default("NGN")
  category   String // tithe, offering, donation, seed
  gateway    String // paystack, stripe
  reference  String   @unique
  status     String   @default("pending")
  receiptUrl String?  @map("receipt_url")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("giving_transactions")
}

model Course {
  id          String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  title       String
  description String?
  coverUrl    String? @map("cover_url")
  isPublished Boolean @default(false) @map("is_published")
  createdBy   String? @map("created_by") @db.Uuid

  user        User?        @relation(fields: [createdBy], references: [id])
  lessons     Lesson[]
  enrollments Enrollment[]

  @@map("courses")
}

model Lesson {
  id              String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  courseId        String  @map("course_id") @db.Uuid
  title           String
  videoUrl        String? @map("video_url")
  pdfUrl          String? @map("pdf_url")
  durationSeconds Int?    @map("duration_seconds")
  sortOrder       Int     @default(0) @map("sort_order")

  course        Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  quizQuestions QuizQuestion[]
  quizAttempts  QuizAttempt[]

  @@map("lessons")
}

model Enrollment {
  id              String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  courseId        String    @map("course_id") @db.Uuid
  progressPercent Int       @default(0) @map("progress_percent")
  completedAt     DateTime? @map("completed_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@map("enrollments")
}

model QuizQuestion {
  id           String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  lessonId     String @map("lesson_id") @db.Uuid
  question     String
  optionsJson  Json   @map("options_json")
  correctIndex Int    @map("correct_index")

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@map("quiz_questions")
}

model QuizAttempt {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  lessonId    String   @map("lesson_id") @db.Uuid
  score       Int
  total       Int
  submittedAt DateTime @default(now()) @map("submitted_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@map("quiz_attempts")
}

model PodcastEpisode {
  id              String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  title           String
  description     String?
  audioUrl        String    @map("audio_url")
  durationSeconds Int?      @map("duration_seconds")
  publishedAt     DateTime? @default(now()) @map("published_at")
  createdBy       String?   @map("created_by") @db.Uuid

  user User? @relation(fields: [createdBy], references: [id])

  @@map("podcast_episodes")
}

model Product {
  id          String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  title       String
  description String?
  type        String // digital, physical
  price       Decimal @db.Decimal(12, 2)
  currency    String  @default("NGN")
  mediaUrl    String? @map("media_url")
  coverUrl    String? @map("cover_url")
  stock       Int?
  isActive    Boolean @default(true) @map("is_active")

  orders Order[]

  @@map("products")
}

model Order {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  stripePiId  String?  @map("stripe_pi_id")
  paystackRef String?  @map("paystack_ref")
  status      String   @default("pending")
  createdAt   DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("orders")
}

model Notification {
  id        String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      String
  title     String
  body      String?
  dataJson  Json?     @default("{}") @map("data_json")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model ServiceSchedule {
  id         String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  title      String
  dayOfWeek  Int     @map("day_of_week")
  time       String
  location   String?
  recurrence String  @default("weekly")
  isActive   Boolean @default(true) @map("is_active")

  attendance Attendance[]

  @@map("service_schedules")
}

model Attendance {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  scheduleId String?  @map("schedule_id") @db.Uuid
  eventId    String?  @map("event_id") @db.Uuid
  attendedAt DateTime @default(now()) @map("attended_at")
  method     String   @default("qr")

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  schedule ServiceSchedule? @relation(fields: [scheduleId], references: [id])
  event    Event?           @relation(fields: [eventId], references: [id])

  @@map("attendance")
}
